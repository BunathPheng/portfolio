# Required: public URL of the FastAPI backend, without a trailing slash.
# The backend must allow this frontend origin through its CORS_ORIGINS setting.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public Cloudflare Turnstile site key used by the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Cloudflare Worker URL for public file metadata.
NEXT_PUBLIC_PORTFOLIO_FILES_API_URL=http://127.0.0.1:8787

# Public R2 custom domain. Images are read from /portfolio/image/<filename>.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://assets.bunath.me

# React Bits Starter/Pro registry license key used by the shadcn CLI.
REACTBITS_LICENSE_KEY=
