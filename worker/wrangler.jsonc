{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "r2_buckets": [
    {
      "binding": "PORTFOLIO",
      "bucket_name": "portfolio"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      "database_id": "6de01487-c662-4c27-b71e-c319006d1ad3"
    }
  ],
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://assets.bunath.me",
    "CORS_ORIGIN": "https://bunath.me"
  }
}
